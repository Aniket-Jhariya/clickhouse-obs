<clickhouse>
    <!-- Copy to storage_policy.xml before building the image.
         Credentials come from the environment - pass them at docker run with:
           -e S3_ACCESS_KEY_ID=...  -e S3_SECRET_ACCESS_KEY=...
         NEVER commit a copy containing literal keys. -->
    <storage_configuration>
        <disks>
            <cold_s3>
                <type>s3</type>
                <endpoint>https://clickhouse-data-pipeline-diacto.s3.ap-south-1.amazonaws.com/data/</endpoint>
                <access_key_id from_env="S3_ACCESS_KEY_ID"/>
                <secret_access_key from_env="S3_SECRET_ACCESS_KEY"/>
                <metadata_path>/var/lib/clickhouse/disks/cold_s3/</metadata_path>
            </cold_s3>
        </disks>
        <policies>
            <hot_to_cold_policy>
                <volumes>
                    <default><disk>default</disk></default>
                    <cold_volume><disk>cold_s3</disk></cold_volume>
                </volumes>
                <move_factor>0.2</move_factor>
            </hot_to_cold_policy>
        </policies>
    </storage_configuration>
</clickhouse>
